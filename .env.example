#Basic single tenant sample
# Replace with your Supabase project values

# Example values (replace in your local .env.* files)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev: point to redirect-dev (Edge Function) which forwards to the Expo tunnel
# EXPO_PUBLIC_REDIRECT_URL=https://your-project-ref.functions.supabase.co/redirect-dev

# Prod: point to redirect (Edge Function) which forwards to the app scheme
EXPO_PUBLIC_REDIRECT_URL=https://your-project-ref.functions.supabase.co/redirect

EXPO_PUBLIC_ENV=development
